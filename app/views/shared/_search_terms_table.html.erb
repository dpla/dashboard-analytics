<% if @search_terms.response.present? && @search_terms.response.total_results.to_i > 0 %>

  <div class="result-info">
    <%= page_window(@search_terms.response.total_results,
                    Array(@search_terms.response.rows).count, "search terms") %>
  </div>

  <div class="download">
    <%= link_to "Download all #{@search_terms.response.total_results} terms",
                controller: :search_terms,
                action: params[:action],
                hub_id: params[:hub_id],
                contributor_id: params[:contributor_id],
                **date_opts,
                format: :csv %>
  </div>

  <table>
    <tr>
      <th>Search Term</th>
      <th>Total Unique Searches</th>
    </tr>
    <% Array(@search_terms.response.rows).each do |row| %>
      <tr>
        <td><%= row[0] %></td>
        <td><%= row[1] %></td>
      </tr>
    <% end %>
  </table>

  <%= render "shared/pagination",
             total: @search_terms.response.total_results,
             page_url: ->(page) { search_term_path(scope, date_opts.merge(page: page)) } %>

<% elsif @search_terms.response.present? %>
  No search terms recorded for this time period.
<% else %>
  Data not available.
<% end %>
