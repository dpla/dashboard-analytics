<div class="date-select">
  <%= form_tag(request.path, method: :get) do %>
    <%= label_tag(:start_date, 'Start:') %>
    <%= select_tag(:start_date, options_for_select(start_date_form_options, current_start_date)) %>

    <%= label_tag(:end_date, 'End:') %>
    <%= select_tag(:end_date, options_for_select(end_date_form_options, current_end_date)) %>

    <%= submit_tag 'Refresh', name: nil %>
  <% end %>

  <p class="date-range-note">
    Analytics data is available through <%= data_available_through %>.
    Data updates in the first week of each month.
  </p>

  <% if date_range_active? %>
    <p class="date-range-note">
      Showing <%= @start_date.strftime("%b %Y") %> &ndash; <%= @end_date.strftime("%b %Y") %>.
      <%= link_to "View all-time data", request.path %>
    </p>
  <% else %>
    <p class="date-range-note">View counts are displayed for all time, or search a specific date range.</p>
  <% end %>
</div>
