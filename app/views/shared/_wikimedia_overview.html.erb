<%# Local variables: @wa_data[Hash], @wp_data[Hash], @item_count[Int|Nil], @target[Hub|Contributor] %>

<% if @wa_data.present? && @wa_data.any? { |_, v| v.to_i > 0 } %>

  <table>
    <% WikimediaAnalyticsPresenter.fields.each do |key| %>
      <% value = @wa_data[key] %>
      <% next unless value.to_i > 0 %>
      <tr>
        <td>
          <div class="tooltip">
            <span><%= key.titleize %></span>
            <span class="tooltiptext"><%= find_tooltip(key) %></span>
          </div>
        </td>
        <td>
          <%= number_with_delimiter(value, delimiter: ',') %>
        </td>
      </tr>
    <% end %>
  </table>

<% else %>
  <div class="no-data">Wikimedia upload and page view data not available</div>
<% end %>

<% key = 'wikimediaReady' %>

<% if @wp_data.present? && @wp_data.key?(key) %>
  <% value = @wp_data[key] %>
  <% ready_count = @item_count ? (@item_count.to_f * value.to_f).round : nil %>

  <table>
    <% if WikimediaPreparationsPresenter.fields.include?(key) %>
      <tr>
        <td>
          <div class="tooltip">
            <span><%= key.titleize %></span>
            <span class="tooltiptext">
              <%= wikimedia_readiness_tooltip %>
              <% if ready_count %>
                That's approximately <%= number_with_delimiter(ready_count, delimiter: ',') %> items.
              <% end %>
            </span>
          </div>
        </td>
        <td class="bar <%= percentage_class(value) %>">
          <%= render_percentage(value) %>
        </td>
      </tr>
    <% end %>
  </table>

<% else %>
  <div class="no-data">Wikimedia readiness data not available</div>
<% end %>

<br/>

<p>More data about <%= render_wikimedia_readiness_link(@target) %></p>
