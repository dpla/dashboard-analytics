<div class="item-table">
  <h2><%= @events.label %></h2>

  <div class="description-text">
    <%= find_event_page_description(params[:event_id]) %>
  </div>

  <% if @events.total_results.to_i > 0 %>

  <div class="result-info">
    <%= page_window(@events.total_results, @events.rows.count, "items") %>
  </div>

  <div class="download">
    <%= link_to "Download all #{@events.total_results} items",
                controller: :events,
                action: params[:action],
                **date_opts,
                hub_id: params[:hub_id],
                contributor_id: params[:contributor_id],
                event_id: params[:event_id],
                format: :csv %>
  </div>

  <table>
    <tr>
      <th>Item</th>
      <% unless @contributor %>
        <th>Contributor</th>
      <% end %>
      <th><%= @events.action %></th>
    </tr>
    <% @events.rows.each do |row| %>
    <tr>
      <td>
        <a href="<%= "#{Settings.dpla.base_uri}item/#{@events.id(row)}" %>">
          <%= @events.title(row) %>
        </a>
        <% slugs = @events.memberships(row) %>
        <% if slugs.any? %>
          <div class="curated-membership">
            In <%= curated_noun(@events.membership_kind, slugs.size) %>
            <%= safe_join(slugs.map { |slug|
                  link_to(slug, curated_page_url(@events.membership_kind, slug),
                          target: "_blank", rel: "noopener")
                }, ", ") %>
          </div>
        <% end %>
      </td>
      <% unless @contributor %>
      <td><%= @events.contributor(row) %></td>
      <% end %>
      <td><%= @events.count(row) %></td>
    </tr>
    <% end %>
  </table>

  <% page_url = ->(page) {
       url_for({ controller: :events,
                 action: :show,
                 hub_id: route_id(params[:hub_id]),
                 contributor_id: params[:contributor_id] && route_id(params[:contributor_id]),
                 id: params[:event_id],
                 page: page }.merge(date_opts))
     } %>
  <%= render "shared/pagination", total: @events.total_results, page_url: page_url %>

  <% else %>
    No activity to report from this time period.
  <% end %>
</div>
