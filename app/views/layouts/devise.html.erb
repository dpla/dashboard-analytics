<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>DPLA Analytics Dashboard</title>
    <%= csrf_meta_tags %>

    <%= stylesheet_link_tag 'application', media: 'all',
      'data-turbo-track': 'reload' %>

    <%= javascript_include_tag 'application',
      'data-turbo-track': 'reload',
      'data-turbo-eval': 'false' %>

    <%= favicon_link_tag '/assets/dpla-favicon-black.png' %>

    <%= yield :head_script %>
  </head>

  <body>
    <%= render partial: "shared/pro_navigation" %>
    <header>
      <%= render partial: "shared/header" %>
    </header>

    <main>
      <% if notice.present? %>
        <div class="alert-banner" role="status"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert-banner" role="alert"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>

    <footer>
      <%= render partial: "shared/footer" %>
    </footer>
  </body>
  <%= content_for :render_async %>
</html>
