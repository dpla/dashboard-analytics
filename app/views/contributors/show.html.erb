<%= render partial: "shared/sub_navigation",
  locals: { hub: @contributor.hub } %>

<% content_for :head_script do %>
  <%= javascript_include_tag 'google-analytics', defer: 'defer' %>
<% end %>

<div class="heading">

  <h1><%= @contributor.name %></h1>

  <%= render partial: "shared/date_menu" %>

</div>

<main>

  <%= render partial: "shared/data_menu", locals: { target: @contributor } %>

  <div class="data-content">

    <%= render_async_section hub_contributor_sections_path(
          route_id(@contributor.hub.name), route_id(@contributor.name), date_opts) do %>
      <%= render "shared/loading", message: "Loading metrics…" %>
      <%= render partial: "shared/contributor_sections" %>
    <% end %>

  </div>
</main>
