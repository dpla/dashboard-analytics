<%= render partial: "shared/sub_navigation",
  locals: { hub: @contributor.hub } %>

<% content_for :head_script do %>
  <%= javascript_include_tag 'google-analytics', defer: 'defer' %>
<% end %>

<div class="heading">

  <h1><%= @contributor.name %></h1>

  <%= render partial: "shared/date_menu" %>

</div>

<main>

  <%= render partial: "shared/data_menu", locals: { target: @contributor } %>

  <div class="data-content">

    <div class="data-section">

      <%# === Column 1: Totals (prominent summary card) === %>
      <div class="metrics">

        <div class="tooltip">
          <h2>Totals</h2>
        </div>

        <%= render_async_section hub_contributor_contributor_totals_path(
              @contributor.hub.name, @contributor.name) do %>
          <div>Loading...</div>
        <% end %>

      </div>

      <%# === Column 2: DPLA Website (all-time) === %>
      <div class="metrics">

        <div class="tooltip">
          <h2>DPLA Website (dp.la)</h2>
          <span class="tooltiptext"><%= website_use_tooltip %></span>
        </div>

        <%= render_async_section hub_contributor_contributor_website_overview_path(
              @contributor.hub.name, @contributor.name) do %>
          <div>Loading...</div>
        <% end %>

        <%# TODO: Re-enable BWS section when GA4 property ID is available.
             hub_contributor_contributor_bws_overview_path / bws_use_tooltip / BwsOverview %>

      </div>

      <%# === Column 3: Wikimedia Integration + Metadata Completeness === %>
      <div class="metrics">

        <div class="tooltip">
          <h2>Wikimedia Integration</h2>
        </div>

        <%= render_async_section hub_contributor_contributor_wikimedia_overview_path(
              @contributor.hub.name, @contributor.name) do %>
          <div>Loading...</div>
        <% end %>

        <br/>

        <div class="tooltip">
          <h2>Metadata Completeness</h2>
          <span class="tooltiptext"><%= metadata_completeness_tooltip %></span>
        </div>

        <%= render_async_section hub_contributor_contributor_metadata_completeness_path(
              @contributor.hub.name, @contributor.name, date_opts) do %>
          <div>Loading...</div>
        <% end %>

      </div>

      <%# TODO: Re-enable DPLA API section when data source is confirmed.
           hub_contributor_contributor_api_overview_path / api_use_tooltip / ApiOverview %>

    </div>
  </div>
</main>
