<%= render partial: "shared/sub_navigation", locals: { hub: @hub } %>

<% content_for :head_script do %>
  <%= javascript_include_tag 'google-analytics', defer: 'defer' %>
<% end %>

<div class="heading">

  <h1><%= @target.name %></h1>

  <%= render partial: "shared/date_menu" %>

</div>

<main>

  <%= render partial: "shared/data_menu", locals: { target: @target } %>

  <div class="data-content">

    <% if params[:id] == "view_api" %>

      <% if api_data_for_date_range? %>
        <%= render_async_section api_events_path({ hub_id: params[:hub_id],
                                                  contributor_id: params[:contributor_id],
                                                  event_id: params[:id] }.merge(date_opts)) do %>
          <%= render "shared/loading", message: "Loading results…" %>
        <% end %>
      <% else %>
        Data is not available for this date range.
      <% end %>

    <% else %>
      <%= render_async_section website_events_path({ hub_id: params[:hub_id],
                                                    contributor_id: params[:contributor_id],
                                                    event_id: params[:id] }.merge(date_opts).merge(page_opts)) do %>
        <%= render "shared/loading", message: "Loading results…" %>
      <% end %>
    <% end %>

  </div>
</main>
