<main class="users">
  <h1>Users</h1>

  <div class="clear" />

  <% if flash[:notice] %>
    <div class="notice"><%= flash[:notice] %></div>
  <% end %>

  <div style="margin-bottom: 1.5em; padding: 1em; border: 1px solid #e9dec8; border-radius: 3px; background: #fdf8f0;">
    <strong>Wikimedia Cache</strong>
    <%= button_to "Rebuild Wikimedia Cache",
          admin_wikimedia_cache_rebuild_path,
          method: :post,
          data: { turbo_confirm: "This will rebuild the Wikimedia cache from the CIM API. It runs in the background and may take several minutes. Continue?" },
          style: "margin-left: 1em;" %>
    <span style="margin-left: 0.5em; font-size: 0.85em; color: #777;">
      Monthly automatic rebuild planned for the 8th of each month.
    </span>
  </div>

  <div class="admin-actions">
    <%= button_to "Sign up a new user", new_admin_user_path,
          method: :get, button_class: "admin-primary-button" %>
  </div>

  <table id="users">
    <thead>
      <tr>
        <th>Email</th>
        <th>Hub permissions</th>
        <th>User permissions</th>
        <th>Tasks</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
      <tr>
        <td><%= user.email %></td>
        <td><%= user.hub %></td>
        <td><%= user.admin ? "Admin" : "User" %></td>
        <td>
          <%= button_to "Edit permissions", edit_admin_user_path(user),
            method: :get %>

          <% if user == current_user %>
            <%= button_to "Change password", edit_user_registration_path,
              method: :get %>
          <% else %>
            <%= button_to "Send password reset", send_password_reset_admin_user_path(user),
              method: :post,
              data: { turbo_confirm: "Send password reset instructions to #{user.email}?" } %>
          <% end %>

          <%= button_to "Delete", admin_user_path(user), method: :delete,
            data: { turbo_confirm: "Are you sure you want to delete #{user.email}?" } %>
        </td>
      </tr>
      <% end %>
    </tbody>
  </table>
</main>
