<div class="heading">
  <h1>Hubs</h1>
</div>

<main>
  <% if @hubs.present? %>
    <ul class="hub-grid">
      <% @hubs.each do |hub| %>
        <li class="hub-card">
          <%= link_to hub_path(route_id(hub['term'])), class: "hub-card-link" do %>
            <span class="hub-card-name"><%= hub['term'] %></span>
            <span class="hub-card-count"><%= number_with_delimiter(hub['count']) %> items</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="no-data">There was a problem retrieving hub data.</p>
  <% end %>
</main>
