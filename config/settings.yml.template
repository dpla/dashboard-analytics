##
# The service account must have Viewer access to the GA4 property.
google_analytics:
  # File path to the service account JSON key.
  service_account_json_key: <%= File.join Rails.root, 'google-analytics-key.json' %>
  # GA4 property ID (numeric, without the "properties/" prefix)
  property_id: <%= ENV["GA4_PROPERTY_ID"] %>
  tracking_id: <%= ENV["TRACKING_ID"] %>

dpla_api:
  # include trailing slash
  base_uri: https://api.dp.la/v2/
  key: <%= ENV["DPLA_API_KEY"] %>

dpla:
  # include trailing slash
  base_uri: https://dp.la/

s3:
  bucket: <%= ENV["S3_BUCKET"] %>

# Minimum date for which any dashboard data is available
min_date:
  month: 01
  year: 2018

# First month with per-item event data. GA4 added event_label Jul 18, 2025.
events_min_date:
  month: 07
  year: 2025

# First month with source set data. These are page views, not events,
# so they start before events_min_date.
pss_min_date:
  month: 04
  year: 2023

# First full day after the current GA4 dimensions were registered on
# Sep 11, 2026. Cache keys carry dates, not the shape, so bump
# GaPersistentCache::SCHEMA_VERSION if this date moves.
new_dimensions_date:
  year: 2026
  month: 09
  day: 12

# Minimum date for which api usage data is available
api_min_date:
  month: 05
  year: 2018

# Minimum date for which BWS usage date is available
bws_min_date:
  month: 09
  year: 2020

# Minimum date for which metadata completeness data is available
mc_min_date:
  month: 04
  year: 2018

wikimedia:
  # Minimum pause between consecutive CIM API requests (seconds, float).
  # Increase if the CIM API starts returning 429s despite CIM_CONCURRENCY=1.
  cim_inter_request_delay: <%= ENV["CIM_INTER_REQUEST_DELAY"] || "0.5" %>
